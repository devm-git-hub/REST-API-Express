<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>\
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora Posts</h1>
    <% for(let post of posts) { %>
        <div class="post">
            <h2 class="post-username">@<%= post.username %></h2>
            <p class="post-content"><%= post.content %></p>
            <br>
            <a href="http://localhost:3000/posts/id/<%= post.id %>">View Details</a>
        </div>
    <% } %>

    <br>
    <br>
    <a href="http://localhost:3000/posts/new">Create New Posts</a>
</body>
</html>